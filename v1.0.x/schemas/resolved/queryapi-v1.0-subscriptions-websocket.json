                      "caps",
                      "tags",
                      "device_id",
                      "transport",
                      "subscription"
                    ],
                    "properties": {
                      "id": {
                        "description": "Globally unique identifier for the Receiver",
                        "type": "string",
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
